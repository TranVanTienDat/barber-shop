@model BarberBookingWeb.Models.PagedResult<BarberBookingWeb.Models.BarberService>
@{
    ViewData["Title"] = "Quản lý dịch vụ";
    Layout = "_AdminLayout";
}

<div class="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
    <!-- Header Area -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h3 class="text-2xl font-bold text-base-content">Danh mục dịch vụ</h3>
            <p class="text-sm text-base-content/60">Quản lý các gói dịch vụ, giá cả và thời gian thực hiện.</p>
        </div>
        <a asp-action="CreateService" class="btn btn-primary flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">add_box</span>
            Thêm dịch vụ mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div
            class="bg-primary/10 border border-primary/20 text-primary px-4 py-3 rounded-xl flex items-center gap-2 animate-in fade-in zoom-in duration-300">
            <span class="material-symbols-outlined text-sm">check_circle</span>
            <span class="text-sm font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Filtering Area -->
    <form method="get" class="bg-base-100 p-5 border border-base-content/10 rounded-2xl shadow-sm mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="lg:col-span-2">
                <label class="block text-xs font-bold text-base-content/60 mb-1.5 uppercase tracking-wider">Tìm
                    kiếm</label>
                    <div class="relative">
                        <span
                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40 text-lg">search</span>
                        <input type="text" name="search" value="@ViewBag.Search" placeholder="Tên dịch vụ, danh mục..."
                               class="input input-bordered w-full pl-10" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-base-content/60 mb-1.5 uppercase tracking-wider">Danh
                        mục</label>
                        <select name="categoryId" class="select select-bordered w-full">
                            <option value="">Tất cả</option>
                            @foreach (var cat in (IEnumerable<BarberBookingWeb.Models.Category>)ViewBag.Categories)
                            {
                                if (ViewBag.CategoryId != null && (int)ViewBag.CategoryId == cat.Id)
                                {
                                    <option value="@cat.Id" selected>@cat.Name</option>
                                }
                                else
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-base-content/60 mb-1.5 uppercase tracking-wider">Giá tối
                            thiểu</label>
                            <input type="number" name="minPrice" value="@ViewBag.MinPrice" placeholder="0"
                                   class="input input-bordered w-full" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-base-content/60 mb-1.5 uppercase tracking-wider">Giá tối
                                đa</label>
                                <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="500,000"
                                       class="input input-bordered w-full" />
                            </div>
                        </div>
        
                        <div
                            class="mt-5 pt-5 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-bold opacity-70 whitespace-nowrap">Hiển thị:</span>
                                <select name="pageSize" class="select select-bordered text-sm font-medium">
                                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 dòng</option>
                                    <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 dòng</option>
                                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 dòng</option>
                                </select>
                            </div>
                            <div class="flex items-center gap-3">
                                <a href="/Admin/Services" class="btn btn-ghost flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px]">clear_all</span>
                                    Xóa lọc
                                </a>
                                <button type="submit" class="btn btn-neutral flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px]">filter_list</span>
                                    Lọc dữ liệu
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Services Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        @foreach (var service in Model.Items)
                        {
                            <div
                                class="group bg-base-100 border border-base-content/10 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">
                                <div class="aspect-[4/3] relative overflow-hidden bg-base-200 flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(service.ImageUrl))
                                    {
                                        <img src="@service.ImageUrl"
                                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                             alt="Path: @service.ImageUrl" />
                                        <div class="hidden w-full h-full flex flex-col items-center justify-center text-error bg-error/10">
                                            <span class="material-symbols-outlined text-3xl">broken_image</span>
                                            <span class="text-[8px] font-mono">Lỗi load</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-full h-full flex items-center justify-center text-base-content/20">
                                            <span class="material-symbols-outlined text-5xl">image</span>
                                        </div>
                                    }
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <div class="flex gap-2 w-full">
                                            <a asp-action="EditService" asp-route-id="@service.Id"
                                                   class="btn btn-sm btn-ghost bg-white/20 backdrop-blur-md text-white flex-1 font-bold">Chỉnh
                                                sửa</a>
                                                <form asp-action="DeleteService" asp-route-id="@service.Id" method="post" class="flex-1"
                                                      onsubmit="return confirm('Lão đại có chắc chắn muốn xóa dịch vụ này không?')">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-error bg-error/80 backdrop-blur-md text-white w-full font-bold">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                        @if (service.Price > 200000)
                                        {
                                            <div
                                                class="absolute top-3 right-3 bg-primary text-primary-content text-[10px] font-black px-2 py-1 rounded-full shadow-lg">
                                                PREMIUM</div>
                                            }
                                        </div>
                                        <div class="p-5 flex flex-col flex-1">
                                            <div class="flex justify-between items-start mb-2">
                                                <h4 class="font-bold text-base-content group-hover:text-primary transition-colors">
                                                    @service.Name</h4>
                                                    <span class="text-primary font-black">@((service.Price / 1000).ToString("N0"))k</span>
                                                </div>
                                                <div class="flex items-center gap-4 text-xs text-base-content/60 mb-4">
                                                    <div class="flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-sm">schedule</span> @service.DurationInMinutes ph
                                                    </div>
                                                    <div class="flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-sm">category</span> @(service.Category?.Name ??
                                                                                                                                    service.CategoryName)
                                                    </div>
                                                </div>
                                                <p class="text-xs text-base-content/40 line-clamp-2 mt-auto">@service.Description</p>
                                            </div>
                                        </div>
                                    }
        
                                    @if (Model.CurrentPage == 1 && Model.TotalCount > 0)
                                    {
                                        <!-- Add New Card Placeholder only on first page -->
                                        <a asp-action="CreateService"
                                               class="group border-2 border-dashed border-base-content/10 rounded-2xl flex flex-col items-center justify-center p-8 hover:border-primary hover:bg-primary/5 transition-all cursor-pointer min-h-[250px] h-full">
                                            <div
                                                class="w-16 h-16 rounded-full bg-base-200 flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-primary-content transition-all">
                                                <span class="material-symbols-outlined text-3xl">add</span>
                                            </div>
                                            <p class="font-bold text-base-content/40 group-hover:text-primary transition-colors text-sm">Thêm dịch vụ
                                                mới</p>
                                            </a>
                                        }
                                    </div>

                                    @if (Model.TotalCount == 0)
                                    {
                                        <div
                                            class="p-20 text-center flex flex-col items-center gap-4 animate-in fade-in zoom-in duration-500 bg-base-100 rounded-2xl border border-base-content/10 shadow-sm">
                                            <div class="w-16 h-16 rounded-full bg-base-200 flex items-center justify-center">
                                                <span class="material-symbols-outlined text-3xl text-base-content/20">content_cut</span>
                                            </div>
                                            <div class="space-y-1">
                                                <h4 class="font-bold text-base-content text-lg">Không tìm thấy dịch vụ nào</h4>
                                                <p class="text-sm text-base-content/60">Thử một từ khóa khác hoặc tạo dịch vụ mới tại <a
                                                    asp-action="CreateService" class="text-primary hover:underline">đây</a>.</p>
                                                </div>
                                            </div>
                                        }

                                        <!-- Pagination Controls -->
                                        @if (Model.TotalPages > 1)
                                        {
                                            <div
                                                class="bg-base-100 border border-base-200 mt-4 p-4 flex flex-wrap items-center justify-between gap-4 shadow-sm rounded-2xl">
                                                <p class="text-sm text-base-content/70 font-medium">
                                                    Đang hiển thị <span class="text-base-content font-bold">@((Model.CurrentPage - 1) * Model.PageSize +
                                                                                                                                                                                                        1)</span> đến
                                                    <span class="text-base-content font-bold">@(Math.Min(Model.CurrentPage * Model.PageSize,
                                                                                                                                                                                                                        Model.TotalCount))</span> trong tổng số
                                                        <span class="text-base-content font-bold">@Model.TotalCount</span> bản ghi.
                                                    </p>
                                                    <div class="join">
                                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                                        {
                                                            var pageUrl = Url.Action("Services", new
                                                            {
                                                                page = i,
                                                                pageSize = Model.PageSize,
                                                                search = ViewBag.Search,
                                                                minPrice = ViewBag.MinPrice,
                                                                maxPrice = ViewBag.MaxPrice
                                                            });
                                                            <input class="join-item btn btn-square btn-sm" type="radio" name="services-page" aria-label="@i"
                                                                   checked="@(i == Model.CurrentPage ? "checked" : null)" onchange="window.location='@pageUrl'" />
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
