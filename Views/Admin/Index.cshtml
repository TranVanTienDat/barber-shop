@{
    ViewData["Title"] = "Quản lý lịch hẹn";
    Layout = "_AdminLayout";
}

<div class="space-y-8 animate-in fade-in duration-500">
    <!-- Header Thông tin (Statistics) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div
            class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-2">Tổng lịch hẹn</p>
            <div class="flex items-center justify-between">
                <h3 class="text-3xl font-bold">1,248</h3>
                <div class="flex items-center text-primary text-xs font-bold bg-primary/10 px-2.5 py-1 rounded-full">
                    <span class="material-symbols-outlined text-sm mr-1">trending_up</span>+12%
                </div>
            </div>
        </div>
        <div
            class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-2">Hôm nay</p>
            <div class="flex items-center justify-between">
                <h3 class="text-3xl font-bold">42</h3>
                <div class="flex items-center text-primary text-xs font-bold bg-primary/10 px-2.5 py-1 rounded-full">
                    <span class="material-symbols-outlined text-sm mr-1">add</span>5 mới
                </div>
            </div>
        </div>
        <div
            class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-2">Đang chờ</p>
            <div class="flex items-center justify-between">
                <h3 class="text-3xl font-bold">8</h3>
                <div
                    class="flex items-center text-yellow-500 text-xs font-bold bg-yellow-500/10 px-2.5 py-1 rounded-full">
                    <span class="material-symbols-outlined text-sm mr-1">pending_actions</span>Cần xử lý
                </div>
            </div>
        </div>
        <div
            class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-2">Doanh thu dự kiến</p>
            <div class="flex items-center justify-between">
                <h3 class="text-3xl font-bold">2.4M</h3>
                <span
                class="text-slate-400 text-xs font-bold bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-full">VNĐ</span>
            </div>
        </div>
    </div>

    <!-- Filters & Action Area -->
    <div
        class="flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative min-w-[350px]">
                <span
                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                <input
                class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm transition-all"
                placeholder="Tìm kiếm khách hàng, số điện thoại hoặc mã ID..." type="text" />
            </div>
            <button
                class="flex items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 gap-2 hover:bg-slate-50 transition-colors">
                <span class="material-symbols-outlined text-slate-400 text-sm">calendar_month</span>
                <span class="text-sm text-slate-600 font-medium">Chọn ngày</span>
                <span class="material-symbols-outlined text-slate-400 text-sm">expand_more</span>
            </button>
            <button
                class="flex items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 gap-2 hover:bg-slate-50 transition-colors">
                <span class="material-symbols-outlined text-slate-400 text-sm">filter_list</span>
                <span class="text-sm text-slate-600 font-medium">Trạng thái</span>
                <span class="material-symbols-outlined text-slate-400 text-sm">expand_more</span>
            </button>
        </div>
        <div class="flex items-center gap-3">
            <button
                class="p-2.5 text-slate-500 hover:text-primary transition-colors border border-slate-200 dark:border-slate-800 rounded-xl">
                <span class="material-symbols-outlined">download</span>
            </button>
            <button
                class="px-6 py-2.5 bg-primary text-background-dark rounded-xl hover:brightness-105 transition-all font-bold flex items-center gap-2 shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-xl">add_circle</span>
                Tạo lịch hẹn mới
            </button>
        </div>
    </div>

    <!-- Table Container -->
    <div
        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800">
                    <tr>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Khách hàng</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Thông tin liên
                            hệ</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Dịch vụ & Giá
                            </th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Thời gian hẹn
                            </th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Trạng thái</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Thao
                                tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors group">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center font-bold text-sm text-primary">
                                            VA</div>
                                            <div class="flex flex-col">
                                                <span class="text-sm font-bold text-slate-900 dark:text-white">Nguyễn Văn A</span>
                                                <span class="text-[11px] text-slate-500">#BK-8829</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="flex flex-col">
                                            <span class="text-sm text-slate-700 dark:text-slate-300">0901 234 567</span>
                                            <span class="text-xs text-slate-400">vana@gmail.com</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="flex flex-col">
                                            <span class="text-sm font-medium">Cắt tóc nam hiện đại</span>
                                            <span class="text-xs text-primary font-bold">80,000 VNĐ</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="flex flex-col">
                                            <span class="text-sm font-bold text-slate-700 dark:text-slate-200">10:30 sáng</span>
                                            <span class="text-xs text-slate-500">Hôm nay, 24 Tháng 10</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span
                                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-primary/15 text-primary border border-primary/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                                            ĐÃ XÁC NHẬN
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 text-right">
                                        <button
                                            class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-primary transition-all">
                                            <span class="material-symbols-outlined text-xl">more_vert</span>
                                        </button>
                                    </td>
                                </tr>
                                <!-- Row 2 -->
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors group">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <div
                                                class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center font-bold text-sm text-yellow-600">
                                                TL</div>
                                                <div class="flex flex-col">
                                                    <span class="text-sm font-bold text-slate-900 dark:text-white">Trần Thị L</span>
                                                    <span class="text-[11px] text-slate-500">#BK-8830</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5">
                                            <div class="flex flex-col">
                                                <span class="text-sm text-slate-700 dark:text-slate-300">0988 222 111</span>
                                                <span class="text-xs text-slate-400">thilan@live.com</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5">
                                            <div class="flex flex-col">
                                                <span class="text-sm font-medium">Uốn tóc VIP 7 bước</span>
                                                <span class="text-xs text-primary font-bold">250,000 VNĐ</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5">
                                            <div class="flex flex-col">
                                                <span class="text-sm font-bold text-slate-700 dark:text-slate-200">14:00 chiều</span>
                                                <span class="text-xs text-slate-500">Hôm nay, 24 Tháng 10</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5">
                                            <span
                                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-yellow-500/15 text-yellow-600 border border-yellow-500/20">
                                                <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                                                ĐANG CHỜ
                                            </span>
                                        </td>
                                        <td class="px-6 py-5 text-right">
                                            <button
                                                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-primary transition-all">
                                                <span class="material-symbols-outlined text-xl">more_vert</span>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
        
                        <!-- Pagination -->
                        <div
                            class="px-6 py-4 bg-slate-50/50 dark:bg-slate-800/30 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
                            <span class="text-xs font-medium text-slate-500">Hiển thị 10/54 lịch hẹn</span>
                            <div class="flex items-center gap-2">
                                <button
                                    class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-white transition-colors disabled:opacity-30"
                                    disabled>
                                    <span class="material-symbols-outlined text-lg">chevron_left</span>
                                </button>
                                <div class="flex items-center gap-1">
                                    <button
                                    class="w-8 h-8 rounded-lg bg-primary text-background-dark font-bold text-xs shadow-sm">1</button>
                                    <button
                                    class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-white transition-colors text-xs font-medium">2</button>
                                    <button
                                    class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-white transition-colors text-xs font-medium">3</button>
                                </div>
                                <button
                                    class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-white transition-colors">
                                    <span class="material-symbols-outlined text-lg">chevron_right</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
