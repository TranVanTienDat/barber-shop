@{
    ViewData["Title"] = "Cấu hình hệ thống";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl mx-auto space-y-8 animate-in fade-in zoom-in-95 duration-500">
    <!-- Profile Header -->
    <div
        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 flex items-center gap-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full -mr-32 -mt-32"></div>
        <div class="relative">
            <img src="https://ui-avatars.com/api/?name=Mint+Salon&size=100&background=19e680&color=112119"
                 class="w-24 h-24 rounded-2xl shadow-xl ring-4 ring-primary/10" alt="Salon Logo" />
            <button
                class="absolute -bottom-2 -right-2 bg-white dark:bg-slate-800 p-2 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 text-primary hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-sm">photo_camera</span>
            </button>
        </div>
        <div class="relative">
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">MINT SALON - Hà Nội</h3>
            <p class="text-slate-500 text-sm mt-1">Quản lý các thông tin cơ bản và cấu hình vận hành của cửa tiệm.</p>
            <div class="flex gap-2 mt-4">
                <span
                    class="px-3 py-1 bg-primary/10 text-primary text-[10px] font-black uppercase rounded-full tracking-wider">Đang
                    hoạt động</span>
                    <span
                        class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 text-[10px] font-black uppercase rounded-full tracking-wider">Phiên
                        bản 2.0.4</span>
                    </div>
                </div>
            </div>

            <!-- Settings Sections -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Sidebar Navigation (Settings Tabs) -->
                <div class="space-y-2">
                    <button
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl bg-primary text-background-dark font-bold shadow-lg shadow-primary/20 transition-all text-left">
                        <span class="material-symbols-outlined">storefront</span>
                        <span class="text-sm">Thông tin Salon</span>
                    </button>
                    <button
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-all text-left">
                        <span class="material-symbols-outlined">schedule</span>
                        <span class="text-sm">Giờ hoạt động</span>
                    </button>
                    <button
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-all text-left">
                        <span class="material-symbols-outlined">security</span>
                        <span class="text-sm">Bảo mật tài khoản</span>
                    </button>
                    <button
                        class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-all text-left">
                        <span class="material-symbols-outlined">notifications_active</span>
                        <span class="text-sm">Thông báo & Email</span>
                    </button>
                </div>

                <!-- Settings Form Area -->
                <div class="md:col-span-2 space-y-6">
                    <div
                        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 shadow-sm">
                        <h4 class="text-lg font-bold mb-6 text-slate-900 dark:text-white">Thông tin cơ bản</h4>
                
                        <div class="space-y-5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="space-y-2">
                                    <label class="text-xs font-black uppercase text-slate-500 tracking-wider">Tên Salon</label>
                                    <input type="text" value="MINT SALON"
                                           class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm font-medium transition-all" />
                                </div>
                                <div class="space-y-2">
                                    <label class="text-xs font-black uppercase text-slate-500 tracking-wider">Hotline</label>
                                    <input type="text" value="0901 222 333"
                                           class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm font-medium transition-all" />
                                </div>
                            </div>
                    
                            <div class="space-y-2">
                                <label class="text-xs font-black uppercase text-slate-500 tracking-wider">Địa chỉ chi
                                    nhánh</label>
                                    <textarea rows="3"
                                              class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm font-medium transition-all">123 Đường Cầu Giấy, Quận Cầu Giấy, Hà Nội</textarea>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-xs font-black uppercase text-slate-500 tracking-wider">Mô tả ngắn</label>
                                    <input type="text" value="Nơi tạo nên phong cách của bạn."
                                           class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm font-medium transition-all" />
                                </div>
                            </div>

                            <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-3">
                                <button
                                    class="px-6 py-2.5 rounded-xl text-sm font-bold text-slate-500 hover:bg-slate-50 transition-colors">Hủy
                                    bỏ</button>
                                    <button
                                        class="px-8 py-2.5 bg-primary text-background-dark rounded-xl font-bold shadow-lg shadow-primary/20 hover:brightness-105 transition-all text-sm">Lưu
                                        thay đổi</button>
                                    </div>
                                </div>

                                <div class="bg-red-500/5 border border-red-500/20 rounded-3xl p-6 flex items-center justify-between">
                                    <div>
                                        <h5 class="text-red-600 font-bold text-sm">Xóa vĩnh viễn dữ liệu Salon</h5>
                                        <p class="text-red-500/60 text-xs mt-1">Cẩn thận! Thao tác này không thể hoàn tác.</p>
                                    </div>
                                    <button
                                        class="px-4 py-2 bg-red-500 text-white rounded-xl text-xs font-bold hover:bg-red-600 transition-colors shadow-lg shadow-red-500/20">Xóa
                                        dữ liệu</button>
                                    </div>
                                </div>
                            </div>
                        </div>
