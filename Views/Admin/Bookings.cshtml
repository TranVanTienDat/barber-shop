@model BarberBookingWeb.Models.PagedResult<BarberBookingWeb.Models.Booking>
@{
    ViewData["Title"] = "Quản lý lịch đặt";
    Layout = "_AdminLayout";
}

<div class="space-y-8 animate-in fade-in slide-in-from-right-4 duration-500">
    <!-- Header Area -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h3 class="text-2xl font-bold text-base-content">Danh sách Lịch đặt</h3>
            <p class="text-sm text-base-content/60">Theo dõi và quản lý các yêu cầu đặt lịch từ khách hàng.</p>
        </div>
        <div class="flex gap-3">
            <a asp-action="ExportBookingsToExcel" asp-route-search="@ViewBag.Search"
                   asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate"
                   asp-route-status="@ViewBag.Status" class="btn btn-success btn-outline flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">download</span>
                Xuất Excel
            </a>
            <a asp-action="CreateBooking" class="btn btn-primary flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">add_circle</span>
                Đặt lịch hộ khách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div
            class="bg-primary/10 border border-primary/20 text-primary px-4 py-3 rounded-xl flex items-center gap-2 animate-in fade-in zoom-in duration-300">
            <span class="material-symbols-outlined text-sm font-bold">check_circle</span>
            <span class="text-sm font-bold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Filtering Area -->
    <form method="get" class="card bg-base-100 shadow-sm border border-base-200">
        <div class="card-body p-5">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="form-control lg:col-span-2">
                    <label class="input input-bordered flex items-center gap-2">
                        <span class="material-symbols-outlined text-base opacity-50">search</span>
                        <input type="text" name="search" value="@ViewBag.Search" class="grow"
                               placeholder="Tìm kiếm Tên, SĐT, Email..." />
                    </label>
                </div>
                <div class="form-control relative" title="Từ ngày">
                    <input type="hidden" name="startDate" id="startDate_hidden" value="@ViewBag.StartDate" />
                    <button type="button" popovertarget="cally-popover-start" id="cally-start"
                            class="input input-bordered flex items-center justify-between w-full"
                            style="anchor-name: --cally-start;">
                        <span class="text-base-content/70">@(string.IsNullOrEmpty(ViewBag.StartDate?.ToString()) ? "Từ ngày" : ViewBag.StartDate)</span>
                        <span class="material-symbols-outlined text-base opacity-50">calendar_month</span>
                    </button>
                    <!-- Popover Dropdown -->
                    <div popover id="cally-popover-start"
                         class="dropdown bg-base-100 rounded-box shadow-xl border border-base-200 mt-2 p-2"
                         style="position-anchor: --cally-start;">
                        <calendar-date value="@ViewBag.StartDate" class="cally"
                                       onchange="document.querySelector('#cally-start span').innerText = this.value; document.getElementById('startDate_hidden').value = this.value; document.getElementById('cally-popover-start').hidePopover();">
                            <svg aria-label="Previous" class="fill-current size-4" slot="previous"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M15.75 19.5 8.25 12l7.5-7.5"></path>
                            </svg>
                            <svg aria-label="Next" class="fill-current size-4" slot="next"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                            </svg>
                            <calendar-month></calendar-month>
                        </calendar-date>
                    </div>
                </div>
                <div class="form-control relative" title="Đến ngày">
                    <input type="hidden" name="endDate" id="endDate_hidden" value="@ViewBag.EndDate" />
                    <button type="button" popovertarget="cally-popover-end" id="cally-end"
                            class="input input-bordered flex items-center justify-between w-full"
                            style="anchor-name: --cally-end;">
                        <span class="text-base-content/70">@(string.IsNullOrEmpty(ViewBag.EndDate?.ToString()) ? "Đến ngày" : ViewBag.EndDate)</span>
                        <span class="material-symbols-outlined text-base opacity-50">calendar_month</span>
                    </button>
                    <!-- Popover Dropdown -->
                    <div popover id="cally-popover-end"
                         class="dropdown bg-base-100 rounded-box shadow-xl border border-base-200 mt-2 p-2"
                         style="position-anchor: --cally-end;">
                        <calendar-date value="@ViewBag.EndDate"
                                       class="cally bg-base-100 border border-base-300 shadow-lg rounded-box"
                                       onchange="document.querySelector('#cally-end span').innerText = this.value; document.getElementById('endDate_hidden').value = this.value; document.getElementById('cally-popover-end').hidePopover();">
                            <svg aria-label="Previous" class="fill-current size-4" slot="previous"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M15.75 19.5 8.25 12l7.5-7.5"></path>
                            </svg>
                            <svg aria-label="Next" class="fill-current size-4" slot="next"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                            </svg>
                            <calendar-month></calendar-month>
                        </calendar-date>
                    </div>
                </div>
                <div class="form-control">
                    <select name="status" class="select select-bordered w-full">
                        <option value="">Trạng thái: Tất cả</option>
                        @foreach (var s in Enum.GetValues(typeof(BarberBookingWeb.Models.BookingStatus)))
                        {
                            <option value="@s"
                                    selected="@((BarberBookingWeb.Models.BookingStatus?)ViewBag.Status == (BarberBookingWeb.Models.BookingStatus)s ? "selected" : null)">
                                @s
                            </option>
                        }
                    </select>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center justify-between gap-4 mt-4 pt-4 border-t border-base-200">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-bold opacity-70 whitespace-nowrap">Hiển thị:</span>
                    <select name="pageSize" class="select select-bordered select-sm">
                        <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 dòng</option>
                        <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 dòng</option>
                        <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 dòng</option>
                    </select>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/Admin/Bookings" class="btn btn-ghost">
                        <span class="material-symbols-outlined text-[18px]">clear_all</span>
                        Xóa lọc
                    </a>
                    <button type="submit" class="btn btn-neutral">
                        <span class="material-symbols-outlined text-[18px]">filter_list</span>
                        Lọc dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </form>

    <!-- Bookings Table -->
    <div class="card bg-base-100 border border-base-200 shadow-sm overflow-x-auto">
        <table class="table w-full text-left">
            <thead class="bg-base-200/50 text-base-content/70">
                <tr>
                    <th class="px-6 py-4 text-xs font-bold uppercase">Khách hàng</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase">Dịch vụ</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase">Thời gian</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase">Trạng thái</th>
                    <th class="px-6 py-4 text-xs font-bold uppercase text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Items)
                {
                    <tr class="hover:bg-base-200/50 transition-colors border-b border-base-200">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-base-200 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-base-content/50">person</span>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-sm font-bold text-base-content">@(booking.Customer?.FullName ??
                                                                                                                                                                                                                                                                                                                                                                                                            booking.CustomerName)</span>
                                        <span class="text-[10px] text-base-content/60">@booking.CustomerPhone</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-5">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var bs in booking.BookingServices)
                                    {
                                        <span class="px-2 py-0.5 bg-base-200 text-base-content/70 rounded-md text-[10px] font-bold">
                                            @bs.BarberService.Name
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-5">
                                <div class="flex flex-col">
                                    <span
                                    class="text-sm font-medium text-base-content">@booking.StartTime.ToString("dd/MM/yyyy")</span>
                                    <span class="text-xs text-base-content/60">@booking.StartTime.ToString("HH:mm") -
                                        @booking.EndTime.ToString("HH:mm")</span>
                                        @if (ViewBag.OverlappingIds != null &&
                                                                                                                                                                                                                                                                            ((List<Guid>)ViewBag.OverlappingIds).Contains(booking.Id))
                                        {
                                            <div class="badge badge-error badge-sm gap-1 mt-1 font-bold">
                                                <span class="material-symbols-outlined text-[14px]">warning</span>
                                                Chồng chéo
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    @{
                                        var statusClass = booking.Status switch
                                        {
                                            BarberBookingWeb.Models.BookingStatus.Pending => "badge-warning",
                                            BarberBookingWeb.Models.BookingStatus.Confirmed => "badge-info",
                                            BarberBookingWeb.Models.BookingStatus.Completed => "badge-success text-success-content",
                                            BarberBookingWeb.Models.BookingStatus.Cancelled => "badge-error",
                                            _ => "badge-ghost"
                                        };
                                        var statusText = booking.Status switch
                                        {
                                            BarberBookingWeb.Models.BookingStatus.Pending => "Chờ duyệt",
                                            BarberBookingWeb.Models.BookingStatus.Confirmed => "Đã xác nhận",
                                            BarberBookingWeb.Models.BookingStatus.Completed => "Hoàn thành",
                                            BarberBookingWeb.Models.BookingStatus.Cancelled => "Đã hủy",
                                            _ => booking.Status.ToString()
                                        };
                                    }
                                    <div class="badge @statusClass badge-sm font-bold uppercase py-3 px-3 shadow-sm border-0">
                                        @statusText
                                    </div>
                                </td>
                                <td class="px-6 py-5 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        @if (booking.Status == BarberBookingWeb.Models.BookingStatus.Pending)
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" class="inline">
                                                <input type="hidden" name="id" value="@booking.Id" />
                                                <input type="hidden" name="status"
                                                       value="@((int)BarberBookingWeb.Models.BookingStatus.Confirmed)" />
                                                <button type="submit" class="btn btn-ghost btn-sm btn-circle text-info"
                                                        title="Xác nhận">
                                                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                                                </button>
                                            </form>
                                        }
                                        @if (booking.Status == BarberBookingWeb.Models.BookingStatus.Confirmed)
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" class="inline">
                                                <input type="hidden" name="id" value="@booking.Id" />
                                                <input type="hidden" name="status"
                                                       value="@((int)BarberBookingWeb.Models.BookingStatus.Completed)" />
                                                <button type="submit" class="btn btn-ghost btn-sm btn-circle text-success"
                                                        title="Hoàn thành">
                                                    <span class="material-symbols-outlined text-[20px]">task_alt</span>
                                                </button>
                                            </form>
                                        }
                                        @if (booking.Status != BarberBookingWeb.Models.BookingStatus.Cancelled && booking.Status !=
                                                                                                                                                                                                                                                                                                                                                                                                    BarberBookingWeb.Models.BookingStatus.Completed)
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" class="inline">
                                                <input type="hidden" name="id" value="@booking.Id" />
                                                <input type="hidden" name="status"
                                                       value="@((int)BarberBookingWeb.Models.BookingStatus.Cancelled)" />
                                                <button type="submit" class="btn btn-ghost btn-sm btn-circle text-warning"
                                                        title="Hủy lịch">
                                                    <span class="material-symbols-outlined text-[20px]">cancel</span>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="DeleteBooking" method="post"
                                              onsubmit="return confirm('Xóa lịch đặt này vĩnh viễn?')" class="inline">
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <button type="submit"
                                                    class="btn btn-ghost btn-sm btn-circle text-base-content/40 hover:text-error transition-colors"
                                                    title="Xóa">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Items.Any())
                {
                    <div class="p-20 text-center flex flex-col items-center gap-4 animate-in fade-in zoom-in duration-500">
                        <div class="w-16 h-16 rounded-full bg-base-200 flex items-center justify-center">
                            <span class="material-symbols-outlined text-3xl text-base-content/30">calendar_month</span>
                        </div>
                        <div class="space-y-1">
                            <h4 class="font-bold text-base-content text-lg">Chưa có lịch hẹn nào</h4>
                            <p class="text-sm text-base-content/60">Bắt đầu nhận lịch hoặc tạo lịch đặt thủ công cho khách.</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            @if (Model.TotalPages > 1)
            {
                <div
                    class="bg-base-100 border border-base-200 mt-4 p-4 flex flex-wrap items-center justify-between gap-4 shadow-sm rounded-2xl">
                    <p class="text-sm text-base-content/70 font-medium">
                        Đang hiển thị <span class="text-base-content font-bold">@(((Model.CurrentPage - 1) * Model.PageSize) +
                                                                                                                                                                                                                                                                1)</span> đến
                        <span class="text-base-content font-bold">@(Math.Min(Model.CurrentPage * Model.PageSize,
                                                                                                                                                                                                                                                                                                        Model.TotalCount))</span> trong tổng số
                            <span class="text-base-content font-bold">@Model.TotalCount</span> bản ghi.
                        </p>
                        <div class="join">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                var pageUrl = Url.Action("Bookings", new
                                {
                                    page = i,
                                    pageSize = Model.PageSize,
                                    search = ViewBag.Search,
                                    startDate = ViewBag.StartDate,
                                    endDate = ViewBag.EndDate,
                                    status = ViewBag.Status
                                });
                                <input class="join-item btn btn-square btn-sm" type="radio" name="booking-page" aria-label="@i"
                                       checked="@(i == Model.CurrentPage ? "checked" : null)" onchange="window.location='@pageUrl'" />
                            }
                        </div>
                    </div>
                }
            </div>
