@{
    Layout = "_BaseLayout";
}

<!-- Header -->
<header
    class="h-20 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-50 flex items-center justify-between px-8 md:px-16">
    <div class="flex items-center gap-3">
        <div class="bg-primary p-2 rounded-xl shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined text-background-dark font-bold relative top-[1px]">content_cut</span>
        </div>
        <h1 class="text-xl font-bold tracking-tight">Salon Làm Đẹp</h1>
    </div>
</header>

<!-- Main Content -->
<main class="flex-1 w-full max-w-5xl mx-auto px-4 md:px-8 py-12">
    @RenderBody()
</main>

<!-- Footer -->
<footer
    class="mt-auto py-8 text-center text-sm text-slate-500 border-t border-slate-200 dark:border-slate-800 flex flex-col items-center gap-4">
    <p>&copy; 2026 Salon Làm Đẹp. Mở cửa hàng ngày từ 08:30 - 20:30.</p>
    <div class="flex items-center gap-4">
        <span class="material-symbols-outlined text-lg hover:text-primary cursor-pointer transition-colors">share</span>
        <span
        class="material-symbols-outlined text-lg hover:text-primary cursor-pointer transition-colors">pin_drop</span>
    </div>
</footer>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
