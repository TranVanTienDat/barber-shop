@{
    var title = ViewData["Title"] ?? "Barber Booking";
    var bodyClass = ViewData["BodyClass"] as string ?? "flex flex-col";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />
    <style type="text/tailwindcss">
        @@theme {
        --font-display: "Inter", sans-serif;
        --color-primary: #19e680;
        --color-primary-hover: #15c96e;
        --color-primary-soft: rgba(25, 230, 128, 0.1);
        }

        /* Ensure white text on primary backgrounds */
        .btn-primary, .bg-primary, .badge-primary {
        color: white !important;
        }
        
        .btn-primary:hover, .btn-primary:active {
        color: white !important;
        }

        /* Global Calendar Overrides for Cally */
        calendar-month::part(button selected) {
        background-color: var(--p);
        color: white !important;
        box-shadow: 0 4px 12px var(--p-soft);
        }

        calendar-month::part(button):hover {
        background-color: var(--p-hover);
        color: white !important;
        }

        calendar-month::part(button today) {
        color: var(--p);
        font-weight: 800;
        }

        calendar-month::part(button today selected) {
        color: white !important;
        }
        
        :root {
        /* DaisyUI Theme Variables - HSL Format */
        /* Primary: #19e680 (147, 80%, 48%) */            --p: 145 80% 50%; /* #19e680 */
        --pc: 0 0% 100%; /* Text trên nền Primary là màu TRẮNG */
        --p-hover: 145 80% 45%;
        --p-soft: 145 80% 50% / 0.15;   /* Background and Surfaces */
        --b1: 153 20% 98%; /* Light surface with a tint of green */
        --b2: 153 15% 94%; 
        --b3: 153 10% 90%;
            
        /* Neutral */
        --n: 153 10% 20%;
        --nc: 0 0% 100%;
            
        /* Rounded corners */
        --rounded-box: 1.5rem;
        --rounded-btn: 0.75rem;
        --rounded-badge: 1.9rem;
        }

        .dark {
        --b1: 153 35% 6%; /* Deep emerald black */
        --b2: 153 30% 9%;
        --b3: 153 25% 12%;
        --p: 147 85% 55%; /* Slightly brighter primary for dark mode */
        }

        body { 
        font-family: 'Inter', sans-serif;
        background-color: oklch(from hsl(var(--b1)) l c h);
        }
        
        /* Glassmorphism utility */
        .glass-card {
        @@apply bg-white/70 dark:bg-emerald-950/40 backdrop-blur-md border border-white/20 dark:border-emerald-800/20 shadow-xl;
        }

        .material-symbols-outlined { 
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; 
        }
    </style>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="min-h-screen @bodyClass" data-theme="light">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
